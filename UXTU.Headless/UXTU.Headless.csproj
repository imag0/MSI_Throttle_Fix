<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MSIThrottleFix</AssemblyName>
    <RootNamespace>UXTU.Headless</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reuse UXTU's current PawnIO driver wrapper directly. -->
    <Compile Include="..\Universal x86 Tuning Utility\Scripts\AMD Backend\AMDPawnIO.cs"
             Link="Backend\AMDPawnIO.cs" />

    <!-- Keep the PawnIO module next to the standalone helper. -->
    <Content Include="..\Universal x86 Tuning Utility\Assets\AMD\PawnIO\RyzenSMU.bin"
             Link="Assets\AMD\PawnIO\RyzenSMU.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
